/bin/
signed_sessions/
null

# Secrets (archivo real con token — NUNCA subir; el template es
# secretos.example.dart y el CI lo genera)
lib/config/secrets.dart
lib/config/secretos.dart

# Keystore de release + credenciales de firma — NUNCA versionar.
# Si se filtran, cualquiera puede firmar apps en tu nombre; si se pierden,
# no podrás volver a actualizar la app. Backup fuera del repo.
/android/key.properties
/android/keystore/
*.jks
*.keystore

# Backups locales (no versionar)
*.rar

# Build outputs for sharing (Drive) — keep out of git
/APKs Bitly/

# Binarios del release (APKs/instaladores) — se suben a la GitHub Release,
# nunca al repo
/dist/

# Capturas de prueba en la raíz (emuladores/PC) — no versionar
/emul*.png
/shot*.png
/setup*.png
/pc_*.png
/s*.png
/error_texto*.png

