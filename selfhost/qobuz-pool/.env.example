[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# Variables del Worker del pool de Qobuz (deeplinks/proxy-qobuz/worker.js).
#
# En Cloudflare Workers no hay .env: estas claves se cargan como
# variables/secretos del Worker (panel o `wrangler secret put <NOMBRE>`).
# Este archivo es la lista de lo que hace falta, para no olvidarse de
# ninguna.
# ─────────────────────────────────────────────────────────────

# ── Claves de la API de Qobuz (imprescindible) ───────────────
# Con estas se firma el relay (/api.json/0.2/*) y se sirve /keys.
QOBUZ_APP_ID=
QOBUZ_APP_SECRET=

# ── Pool de sesiones (imprescindible para /pool) ─────────────
# Tokens de sesión de Qobuz (user_auth_token), uno por cuenta,
# separados por coma. Cada token es una cuenta con suscripción: es el
# pool que sostiene la descarga directa de FLAC.
QOBUZ_AUTH_TOKENS=

# ── Secreto del pool (recomendado) ──────────────────────────
# Con esto puesto, /pool sólo responde si el secreto viaja en la
# RUTA (https://TU-WORKER.workers.dev/pool/<secreto>) o en la query
# (?s=<secreto>). Sin esto, /pool queda ABIERTO: cualquiera con el
# link ve tus tokens.
QOBUZ_POOL_SECRET=

# ── Token suelto (opcional) ──────────────────────────────────
# Si tenés UNA cuenta con suscripción y querés que también el relay
# firmado use su sesión (va por cabecera X-User-Auth-Token).
QOBUZ_USER_TOKEN=
