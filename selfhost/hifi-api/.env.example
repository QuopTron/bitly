# Config de tu instancia de hifi-api (ver el README de esta carpeta).
# Copialo a .env; las variables son OPCIONALES salvo el token de Tidal.

# ── Cuentas de Tidal ────────────────────────────────────────────────────────
# Lo normal es dejar token.json al lado del código (lo genera tidal_auth).
# Si preferís variables, estos son los equivalentes de una cuenta de CATÁLOGO
# (solo metadata/ISRC; no necesita suscripción):
#CATALOG_CLIENT_ID=
#CATALOG_CLIENT_SECRET=
#CATALOG_REFRESH_TOKEN=
#CATALOG_TOKEN=

# ── Red ─────────────────────────────────────────────────────────────────────
# Rotar proxies baja el riesgo de baneo por saltar de IP.
#USE_PROXIES=False
#PROXIES_FILE=proxies.txt
#ROTATE_PROXIES_ON_REFRESH=False
#MAX_RETRIES=2
# OJO: si lo prendés y los proxies fallan, expone la IP del host.
#FALLBACK_TO_DIRECT_CONNECTION=False

# ── Servidor ────────────────────────────────────────────────────────────────
# main.py escucha en 0.0.0.0:8000 por defecto. NO lo expongas a internet sin
# autenticación: es tu cuenta de Tidal la que firma.
#PORT=8000
