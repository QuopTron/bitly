# ─────────────────────────────────────────────────────────────
# .env — instancia propia de arcod (mínima, solo catálogo + stream).
#
# Copialo a .env y completá las CUATRO primeras claves. Sin
# QOBUZ_AUTH_TOKENS la instancia arranca pero no puede resolver
# ninguna canción: su catálogo vive de esas cuentas.
# ─────────────────────────────────────────────────────────────

# ── Qobuz (imprescindible) ───────────────────────────────────
# El repo trae estos dos valores en su README; son los de la app web de Qobuz.
QOBUZ_API_BASE=https://www.qobuz.com/api.json/0.2/
QOBUZ_APP_ID=
QOBUZ_SECRET=
# Tokens de sesión de Qobuz, separados por coma. Cada token es la sesión
# de una cuenta. Es el pool que sostiene TODAS las resoluciones.
QOBUZ_AUTH_TOKENS=

# Varios dominios de Qobuz están restringidos por país: si un token
# responde 403, probá otro país (p.ej. US, FR, MX).
# QOBUZ_COUNTRY=US

# ── Qué calidad puede pedir un invitado ──────────────────────
# 5 = MP3 320 · 6 = FLAC · 7 = FLAC 24/≤96 · 27 = FLAC hi-res (por defecto).
# Poné 5 si querés reservar el FLAC para quien tenga sesión.
STREAM_GUEST_QUALITY=27

# ── Sesiones (opcional) ──────────────────────────────────────
# Solo si querés que /api/player/stream valide el Bearer contra tu Supabase.
# Si lo dejás vacío, la instancia es abierta y STREAM_GUEST_QUALITY manda.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Extras del sitio que no hacen falta para servir audio ────
# (dejalos vacíos si solo querés la API de catálogo + stream)
NEXT_PUBLIC_APPLICATION_NAME=arcod
NEXT_PUBLIC_AWS_API_URL=
NEXT_PUBLIC_AWS_CLOUDFRONT_DOMAIN=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_LYRICS_SERVICE_URL=
TIDAL_AUTH_TOKEN=
TIDAL_COUNTRY_CODE=
CORS_PROXY=
SOCKS5_PROXY=
