# Podfile de macOS — Flutter 3.41+ genera Flutter-Generated.xcconfig en
# ephemeral/, no en la raíz. Este Podfile sigue el template oficial con
# una adición: firma ad-hoc de los frameworks de ffmpeg_kit_flutter_new_audio
# (vienen sin firma y el CodeSign final de la app falla en CI).

platform :osx, '10.15'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # Fix firma: TODOS los frameworks vendidos por pods (ffmpeg_kit, media_kit,
  # etc.) vienen sin firma. Xcode falla al firmar el .app porque los
  # sub-frameworks están unsigned. Los firmamos ad-hoc aquí, ANTES de que
  # xcodebuild copie al .app.
  pods_dir = File.expand_path('Pods', __dir__)
  Dir.glob(File.join(pods_dir, '**', '*.framework')).each do |fw|
    system('codesign', '--force', '--sign', '-', fw) rescue nil
  end
  # También firmar .xcframework si existe (go_backend)
  Dir.glob(File.join(pods_dir, '**', '*.xcframework')).each do |xcfw|
    Dir.glob(File.join(xcfw, '*', '*.framework')).each do |fw|
      system('codesign', '--force', '--sign', '-', fw) rescue nil
    end
  end
end
