# Podfile de macOS (igual que el template de Flutter + fix de firma).
#
# ffmpeg_kit_flutter_new_audio distribuye sus frameworks (libavfilter, etc.)
# SIN firma: el paso CodeSign final de la app falla con "code object is not
# signed at all" cuando el bundle los embebe. En pod install se firman
# ad-hoc para que el deep-sign del bundle los re-firme sin problema.
# (La app SÍ debe quedar firmada —aunque sea ad-hoc— o Gatekeeper la mata
#  en Apple Silicon.)

platform :osx, '10.15'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # Fix ffmpeg-kit: frameworks sin firma → CodeSign final falla. Se firman
  # ad-hoc aquí (pod install corre antes del build de Xcode).
  frameworks_dir = File.expand_path('Pods/ffmpeg_kit_flutter_new_audio/Frameworks', __dir__)
  if Dir.exist?(frameworks_dir)
    Dir.glob(File.join(frameworks_dir, '*.framework')).each do |fw|
      system('codesign', '--force', '--sign', '-', fw)
    end
  end
end