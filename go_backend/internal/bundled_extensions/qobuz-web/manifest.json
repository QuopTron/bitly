{
  "name": "qobuz-web",
  "displayName": "Qobuz",
  "version": "1.6.0",
  "description": "Qobuz metadata and download provider. Toda la metadata viene de la API PÚBLICA de Qobuz (www.qobuz.com/api.json/0.2, sin gateway y sin verificación de humano) y el audio se baja DIRECTO del CDN con tu propia cuenta (Ajustes → Credenciales → Qobuz).",
  "homepage": "https://github.com/zarzet/SpotiFLAC-Mobile",
  "type": ["metadata_provider", "download_provider"],
  "minAppVersion": "4.9.1",
  "skipMetadataEnrichment": true,
  "requiredRuntimeFeatures": ["preparedContext@1"],
  "permissions": {
    "network": [
      "www.qobuz.com",
      "qobuz.com",
      "play.qobuz.com",
      "open.qobuz.com",
      "static.qobuz.com",
      "streaming-qobuz-std.akamaized.net"
    ],
    "storage": true,
    "file": true
  },
  "qualityOptions": [
    {
      "id": "HI_RES_LOSSLESS",
      "label": "24-Bit Max",
      "description": "Attempt the highest Qobuz hi-res quality first",
      "kind": "lossless"
    },
    {
      "id": "HI_RES",
      "label": "24-Bit",
      "description": "Prefer 24-bit Qobuz quality",
      "kind": "lossless"
    },
    {
      "id": "LOSSLESS",
      "label": "Lossless",
      "description": "Fallback to standard Qobuz lossless quality",
      "kind": "lossless"
    }
  ],
  "capabilities": {
    "downloadFallbackTier": "lossless",
    "networkTimeoutSeconds": 15,
    "replacesBuiltInProviders": ["qobuz"],
    "shareUrlTemplates": {
      "track": "https://open.qobuz.com/track/{id}",
      "album": "https://play.qobuz.com/album/{id}",
      "artist": "https://play.qobuz.com/artist/{id}",
      "playlist": "https://open.qobuz.com/playlist/{id}"
    }
  },
  "serviceHealth": [],
  "searchBehavior": {
    "enabled": true,
    "primary": false,
    "placeholder": "Search Qobuz...",
    "thumbnailRatio": "square",
    "filters": [
      {
        "id": "track",
        "label": "Songs",
        "icon": "music"
      },
      {
        "id": "album",
        "label": "Albums",
        "icon": "album"
      },
      {
        "id": "artist",
        "label": "Artists",
        "icon": "artist"
      }
    ]
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "qobuz.com",
      "www.qobuz.com",
      "play.qobuz.com",
      "open.qobuz.com",
      "qobuzapp://",
      "qobuz:"
    ]
  },
  "settings": [
    {
      "key": "widgetAppId",
      "label": "Qobuz Widget App ID",
      "type": "string",
      "default": "735532640",
      "description": "App ID usado para la metadata anónima de la API pública de Qobuz."
    },
    {
      "key": "countryCode",
      "label": "Country Code",
      "type": "string",
      "default": "US",
      "description": "Country code used for provider requests that require it."
    }
  ]
}
