{
  "name": "deezer",
  "displayName": "Deezer",
  "version": "1.6.0",
  "description": "Deezer metadata provider (complete release, disc, barcode, credits, explicit, genre, rights, link and high-resolution artwork) plus direct full-audio download with your own Deezer account (ARL cookie): MP3 128 on a free account and MP3 320 / FLAC on a paid one, straight from Deezer's CDN. Sin cuenta el audio sale de una fuente abierta, sin verificación ni modal.",
  "homepage": "https://github.com/zarzet/SpotiFLAC-Mobile",
  "type": ["metadata_provider"],
  "minAppVersion": "4.9.1",
  "requiredRuntimeFeatures": ["patternedFileTransform@1", "preparedContext@1"],
  "permissions": {
    "network": [
      "media.deezer.com",
      "api.deezer.com",
      "www.deezer.com",
      "deezer.page.link",
      "link.deezer.com",
      "*.dzcdn.net"
    ],
    "storage": true,
    "file": true
  },
  "qualityOptions": [
    {
      "id": "flac",
      "label": "FLAC",
      "description": "Best available Deezer FLAC stream"
    }
  ],
  "searchBehavior": {
    "enabled": true,
    "primary": true,
    "placeholder": "Search Deezer...",
    "thumbnailRatio": "square",
    "filters": [
      {
        "id": "track",
        "label": "Songs",
        "icon": "music"
      },
      {
        "id": "album",
        "label": "Albums",
        "icon": "album"
      },
      {
        "id": "artist",
        "label": "Artists",
        "icon": "artist"
      },
      {
        "id": "playlist",
        "label": "Playlists",
        "icon": "playlist"
      }
    ]
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "deezer.com",
      "www.deezer.com",
      "deezer.page.link",
      "link.deezer.com",
      "deezer:"
    ]
  },
  "capabilities": {
    "downloadFallbackTier": "lossless",
    "networkTimeoutSeconds": 15,
    "shareUrlTemplates": {
      "album": "https://www.deezer.com/album/{id}",
      "artist": "https://www.deezer.com/artist/{id}"
    }
  },
  "serviceHealth": []
}
