{
  "name": "amazon",
  "displayName": "Amazon Music",
  "version": "2.4.4",
  "description": "Amazon Music metadata provider: browse tracks, albums, artists and playlists from Amazon Music links and search, all from Amazon's own web API. Amazon does not hand over audio without a Prime/Unlimited account, so audio is resolved from an open source instead — sin verificación ni modal.",
  "type": ["metadata_provider", "download_provider"],
  "minAppVersion": "4.9.1",
  "requiredRuntimeFeatures": ["preparedContext@1"],
  "permissions": {
    "network": [
      "na.mesk.skill.music.a2z.com",
      "na.web.skill.music.a2z.com",
      "music.amazon.com",
      "music.amazon.co",
      "music.amazon.de",
      "music.amazon.co.uk",
      "music.amazon.co.jp",
      "music.amazon.fr",
      "music.amazon.it",
      "music.amazon.es",
      "music.amazon.in",
      "music.amazon.com.br",
      "music.amazon.com.mx",
      "music.amazon.com.au",
      "m.media-amazon.com",
      "song.link",
      "api.song.link",
      "odesli.io",
      "api.deezer.com",
      "open.spotify.com",
      "songstats.com",
      "*.cloudfront.net"
    ],
    "storage": true,
    "file": true
  },
  "qualityOptions": [
    {
      "id": "best",
      "label": "FLAC Best Available",
      "description": "Best available quality (up to 24-bit/192kHz)",
      "kind": "lossless"
    },
    {
      "id": "opus",
      "label": "Opus 320kbps",
      "description": "High quality Opus audio at 320kbps",
      "kind": "lossy"
    },
    {
      "id": "eac3",
      "label": "Dolby Digital Plus",
      "description": "Dolby Digital Plus surround sound (E-AC-3)",
      "kind": "spatial"
    },
    {
      "id": "ac4",
      "label": "Dolby Atmos (AC-4)",
      "description": "Dolby Atmos immersive audio (AC-4, MP4 passthrough)",
      "kind": "spatial"
    }
  ],
  "searchBehavior": {
    "enabled": true,
    "placeholder": "Search Amazon Music...",
    "icon": "amazon",
    "thumbnailRatio": "square",
    "filters": [
      {
        "id": "songs",
        "label": "Songs"
      },
      {
        "id": "albums",
        "label": "Albums"
      },
      {
        "id": "artists",
        "label": "Artists"
      },
      {
        "id": "playlists",
        "label": "Playlists"
      }
    ]
  },
  "urlHandler": {
    "enabled": true,
    "patterns": [
      "music.amazon.com",
      "music.amazon.co",
      "music.amazon.de",
      "music.amazon.co.uk",
      "music.amazon.co.jp",
      "music.amazon.fr",
      "music.amazon.it",
      "music.amazon.es",
      "music.amazon.in",
      "music.amazon.com.br",
      "music.amazon.com.mx",
      "music.amazon.com.au"
    ]
  },
  "capabilities": {
    "homeFeed": true,
    "downloadFallbackTier": "hi_res",
    "networkTimeoutSeconds": 15,
    "requiresNativeContainerConversion": true,
    "shareUrlTemplates": {
      "album": "https://music.amazon.com/albums/{id}",
      "artist": "https://music.amazon.com/artists/{id}"
    }
  },
  "serviceHealth": []
}
